<Window x:Class="ThunderPack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="雷霆整合 · ThunderPack" Width="1280" Height="860"
        MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="#F6F7FB"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#202535"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#202535"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9297A6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7356E8"/>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#596074"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.62"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.40"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B9A9F5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#7356E8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E4E7EF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#858B9A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionBorder" Property="Background" Value="#E9EAF2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FAFBFD"/><Setter Property="Foreground" Value="#33394B"/>
            <Setter Property="BorderBrush" Value="#E6E8F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,8"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#C7B9FC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#A38BEF"/><Setter TargetName="InputBorder" Property="Background" Value="White"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="18" Height="18">
                            <Border x:Name="CheckBorder" Background="White" BorderBrush="#D8DCE7" BorderThickness="1" CornerRadius="5"/>
                            <Path x:Name="CheckMark" Visibility="Collapsed" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 5,9 L 8,12 L 13,6"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="#7356E8"/><Setter TargetName="CheckBorder" Property="BorderBrush" Value="#7356E8"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="#9E84F0"/><Setter TargetName="CheckBorder" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Foreground" Value="#596277"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="MenuItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="MenuItemBorder" Property="Background" Value="#F5F1FF"/><Setter Property="Foreground" Value="#7356E8"/></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuItemBorder" Property="Background" Value="#EEE8FD"/><Setter Property="Foreground" Value="#7356E8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#596277"/>
            <Setter Property="Background" Value="#FAFBFD"/>
            <Setter Property="BorderBrush" Value="#E6E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="ComboRoot">
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Cursor="Hand"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#8D95A7" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#B8A5EB"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#A38BEF"/><Setter TargetName="ComboBorder" Property="Background" Value="White"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False" Margin="11,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#E1DCEE" BorderThickness="1" CornerRadius="9" Padding="5" Margin="0,5,0,0" MinWidth="{Binding ActualWidth, ElementName=ComboRoot}">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboRoot" Property="Opacity" Value="0.45"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#A38BEF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterTab" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#8A93A5"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="FilterBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="FilterBorder" Property="Background" Value="#EEE9FD"/><Setter Property="Foreground" Value="#8061D5"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FilterBorder" Property="Background" Value="#F0EDF8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder" Background="White" BorderBrush="#E9ECF3" BorderThickness="1" CornerRadius="12" Padding="13,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#FCFBFF"/><Setter TargetName="RowBorder" Property="BorderBrush" Value="#D9D0F7"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#F8F5FF"/><Setter TargetName="RowBorder" Property="BorderBrush" Value="#BBA9F5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#E2E5EE" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Persistent, deliberately small navigation. -->
            <Border Background="White" BorderBrush="#E8EBF2" BorderThickness="0,0,1,0">
                <Grid Margin="18,27,18,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="3,0,0,38">
                        <Border Width="38" Height="38" Background="#7356E8" CornerRadius="11">
                            <Viewbox Margin="10,7"><Path Fill="White" Data="M 12,0 L 2,14 L 9,14 L 6,25 L 20,9 L 12,9 L 16,0 Z"/></Viewbox>
                        </Border>
                        <StackPanel Margin="10,-1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="雷霆整合" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="THUNDERPACK" Foreground="#858D9E" FontSize="11" Margin="1,4,0,0" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="工作空间" Foreground="#858D9E" FontSize="11" Margin="12,0,0,12"/>
                        <Button Click="Workspace_Click" HorizontalContentAlignment="Left" Background="#F0EBFF" Foreground="#7356E8" Padding="14,13" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal"><Path Width="16" Height="15" Stroke="#7356E8" StrokeThickness="1.2" StrokeLineJoin="Round" Data="M 1,4 L 1,14 L 16,14 L 16,4 L 9,4 L 7,1 L 1,1 Z" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="我的整合包"/></StackPanel>
                        </Button>
                        <Button Click="Guide_Click" HorizontalContentAlignment="Left" Padding="14,13" Margin="0,7,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="使用指南"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,34,0,0">
                        <TextBlock Text="适用范围" Foreground="#858D9E" FontSize="11" Margin="12,0,0,13"/>
                        <Border CornerRadius="13" Background="#1F2541" Height="141">
                            <Grid ClipToBounds="True">
                                <Grid.Clip><RectangleGeometry Rect="0,0,165,141" RadiusX="13" RadiusY="13"/></Grid.Clip>
                                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Ellipse Fill="#2E2F50" Width="112" Height="112" Canvas.Left="86" Canvas.Top="51"/>
                                    <Ellipse Fill="#38345B" Width="67" Height="67" Canvas.Left="109" Canvas.Top="79"/>
                                    <Path Fill="#8270B5" Stroke="#B7A5E2" StrokeThickness="1.1" StrokeLineJoin="Round" Data="M 103,78 L 124,67 L 145,78 L 124,89 Z M 103,78 L 103,101 L 124,113 L 145,101 L 145,78 M 124,89 L 124,113"/>
                                    <Path Fill="#514A7C" Stroke="#A593D0" StrokeThickness="1.1" StrokeLineJoin="Round" Data="M 78,103 L 94,95 L 110,103 L 94,111 Z M 78,103 L 78,122 L 94,130 L 110,122 L 110,103 M 94,111 L 94,130"/>
                                </Canvas>
                                <StackPanel Margin="17,15,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="通用整合" Foreground="White" FontSize="23" FontWeight="Bold"/>
                                    <TextBlock Text="ALL GAMES" Foreground="#C0C1D4" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Margin="1,6,0,0"/>
                                </StackPanel>
                                <Border Background="#263047" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,13" Padding="7,4">
                                    <TextBlock Text="Thunderstore" FontFamily="Segoe UI" FontSize="11" Foreground="#DEDDEE"/>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="12,12,0,0"><Ellipse Width="5" Height="5" Fill="#8BAE9B" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="适用各游戏原始 Mod 包" FontSize="11" Foreground="#858D9E"/></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="4">
                        <Border Height="1" Background="#EEF0F5" Margin="9,0,9,15"/>
                        <Button Click="OpenThunderstore_Click" HorizontalContentAlignment="Left" Padding="12,10">
                            <Grid Width="139"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Thunderstore 官网" FontSize="11"/><TextBlock Grid.Column="1" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/></Grid>
                        </Button>
                        <TextBlock Text="通用 Thunderstore 整合" FontSize="11" Foreground="#9CA3B1" Margin="12,13,0,1"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="33"/></Grid.RowDefinitions>

                <!-- Native window commands are retained in the custom title bar. -->
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                    <TextBlock Text="工作空间  /  新建整合包" FontSize="11" Foreground="#858D9E" Margin="30,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化"/>
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="最大化 / 还原"/>
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="30,9,30,19">
                    <Grid.RowDefinitions><RowDefinition Height="93"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9"><TextBlock Text="MODPACK WORKSPACE" Foreground="#9297A8" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/><Border Background="#EBE7FB" CornerRadius="4" Padding="6,2" Margin="10,-2,0,0"><TextBlock Text="ALL GAMES" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#846BCB"/></Border></StackPanel>
                            <TextBlock Text="把喜欢的 Mod，装进同一个包。" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="导入压缩包，检查前置，一键打包分享。" FontSize="12" Foreground="#858D9E" Margin="1,8,0,0"/>
                        </StackPanel>
                        <Button Click="Import_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,0,0" Padding="18,11">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="+" FontFamily="Segoe UI" FontSize="18" Margin="0,-3,9,0"/><TextBlock Text="添加 Mod" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="23"/><ColumnDefinition Width="286"/></Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="136"/><RowDefinition Height="67"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <Border x:Name="DropZone" CornerRadius="16" Background="#F3F0FE" BorderBrush="Transparent" BorderThickness="2" ToolTip="把从 Thunderstore 下载的 ZIP 压缩包拖到窗口中，可一次导入多个文件">
                                <Grid>
                                    <Rectangle Stroke="#CBBDF3" StrokeThickness="1" StrokeDashArray="4,4" RadiusX="14" RadiusY="14" Margin="1" IsHitTestVisible="False"/>
                                    <Grid Margin="21,17">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#E8E0FC" CornerRadius="13" Width="46" Height="49" VerticalAlignment="Center">
                                            <Viewbox Margin="12"><Path Stroke="#8061D5" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 3,9 L 3,3 L 16,3 L 22,9 L 22,25 L 3,25 L 3,20 M 16,3 L 16,10 L 22,10 M 0,15 L 12,15 M 8,11 L 12,15 L 8,19"/></Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="拖入 Mod 压缩包" FontSize="17" FontWeight="SemiBold" Foreground="#514269"/>
                                            <TextBlock Text="支持多个 .zip · 自动识别前置与版本" FontSize="12" Foreground="#887A9F" Margin="0,7,0,0"/>
                                            <Button Click="Import_Click" HorizontalAlignment="Left" Foreground="#8061D5" Background="White" BorderBrush="#E2D8F7" BorderThickness="1" Padding="11,5" Margin="0,12,0,0" FontSize="11" Content="选择压缩包  ↗"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="164"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Mod 清单" FontSize="14" FontWeight="SemiBold"/><Border Background="#EBEDF4" CornerRadius="5" Margin="8,0,0,0" Padding="6,2"><TextBlock x:Name="ModCountText" Text="0" Foreground="#7C8598" FontSize="11" FontFamily="Segoe UI"/></Border></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                                    <RadioButton x:Name="AllFilterButton" GroupName="ModFilters" Content="全部" IsChecked="True" Style="{StaticResource FilterTab}" Click="AllFilter_Click"/>
                                    <RadioButton x:Name="DependenciesFilterButton" GroupName="ModFilters" Content="前置" Style="{StaticResource FilterTab}" Click="DependenciesFilter_Click"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="White" BorderBrush="#E7EAF1" BorderThickness="1" CornerRadius="8" Height="33">
                                    <Grid>
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#929BAD" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Background="Transparent" BorderThickness="0" Padding="29,7,8,7" FontSize="11" ToolTip="搜索 Mod 名称或作者"/>
                                        <TextBlock Text="搜索 Mod 或作者" IsHitTestVisible="False" Foreground="#929BAD" FontSize="11" VerticalAlignment="Center" Margin="29,0,0,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="3" Click="Clear_Click" Content="清空" FontSize="11" Foreground="#858D9E" Padding="12,8,0,8" Margin="4,0,0,0" ToolTip="清空当前列表，保留原始压缩包"/>
                            </Grid>

                            <Border x:Name="DependencyBanner" Grid.Row="2" Background="#FFF7E7" BorderBrush="#F2E5C8" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="IssueText" Text="有前置 Mod 尚未导入" FontSize="11" Foreground="#9B7C42" TextWrapping="Wrap"/><TextBlock x:Name="MissingCountText" Text="0 项待处理" FontSize="11" Foreground="#A58A59" Margin="0,4,0,0"/></StackPanel>
                                    <Button x:Name="ResolveButton" Grid.Column="1" Click="ResolveDependencies_Click" Content="补齐前置" Background="#FFFDF8" BorderBrush="#EBDCBB" BorderThickness="1" Foreground="#947540" FontSize="11" Padding="10,7" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3" MinHeight="125">
                                <Border x:Name="EmptyPanel" Background="White" BorderBrush="#E8EBF2" BorderThickness="1" CornerRadius="15">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,17">
                                        <Canvas Width="86" Height="65" Margin="0,0,0,14" HorizontalAlignment="Center">
                                            <Border Width="39" Height="48" CornerRadius="8" Background="#F1EDF9" BorderBrush="#E7E0F4" BorderThickness="1" Canvas.Left="8" Canvas.Top="8" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-15"/></Border.RenderTransform></Border>
                                            <Border Width="39" Height="48" CornerRadius="8" Background="#F0F2F8" BorderBrush="#E4E8F2" BorderThickness="1" Canvas.Left="40" Canvas.Top="8" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="15"/></Border.RenderTransform></Border>
                                            <Border Width="41" Height="51" CornerRadius="8" Background="#FAF9FE" BorderBrush="#DFD7F4" BorderThickness="1" Canvas.Left="23" Canvas.Top="7">
                                                <Viewbox Margin="11,14"><Path Stroke="#B5A5DD" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M 1,6 L 9,2 L 17,6 L 9,10 Z M 1,6 L 1,15 L 9,19 L 17,15 L 17,6 M 9,10 L 9,19"/></Viewbox>
                                            </Border>
                                        </Canvas>
                                        <TextBlock x:Name="EmptyTitleText" Text="整合包里还空空的" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#747C8E"/>
                                        <TextBlock x:Name="EmptyHintText" Text="从 Thunderstore 下载 Mod，直接拖到这里。" FontSize="12" Foreground="#858D9E" Margin="0,9,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="ModListBox" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="ModSelection_Changed"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="ModToggle_Changed" ToolTip="加入 / 排除整合包"/>
                                                <Border Grid.Column="1" Width="36" Height="38" Background="#EFEAFB" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold" Foreground="#A18CCB" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding Icon}" Width="34" Height="34" Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding Author}" FontSize="11" Foreground="#858D9E" MaxWidth="150" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RoleLabel}" FontSize="11" Foreground="#8D73BD" Margin="8,0,0,0"/></StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,7,0">
                                                    <TextBlock Text="{Binding VersionLabel}" Foreground="#8F97A7" FontSize="11" HorizontalAlignment="Right"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0"><TextBlock Text="{Binding SizeLabel}" Foreground="#929BAD" FontSize="11"/><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="11" Margin="8,0,0,0"/></StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="4" Click="RemoveMod_Click" Tag="{Binding Key}" Content="×" FontFamily="Segoe UI" FontSize="17" Foreground="#959EB0" Padding="4,0" VerticalAlignment="Center" ToolTip="移除此 Mod"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <Border Grid.Row="4" Background="White" BorderBrush="#E8EBF2" BorderThickness="1" CornerRadius="13" Padding="16,13" Margin="0,13,0,0" MinHeight="109">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock x:Name="SelectionNameText" Text="Mod 详情" FontSize="11" FontWeight="SemiBold" Foreground="#727B8D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,115,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="FixAuthorButton" Click="FixAuthor_Click" Content="补充作者" FontSize="11" Foreground="#9278CF" Padding="5,2" Visibility="Collapsed"/>
                                            <Button x:Name="RemoveSelectedButton" Click="RemoveSelected_Click" Content="移除" FontSize="11" Foreground="#858D9E" Padding="6,2" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="SelectionDescriptionText" Grid.Row="1" Text="选择一个 Mod，查看简介和前置依赖。" Foreground="#858D9E" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SelectionDependenciesText" Grid.Row="2" Text="前置信息将在导入后显示" Foreground="#9099AA" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Export stays visible while the mod list scrolls. -->
                        <Border Grid.Column="2" Background="White" BorderBrush="#E7EAF2" BorderThickness="1" CornerRadius="16" Padding="21,22,21,19">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ScrollViewer x:Name="ExportSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" Margin="0,0,-6,12" Padding="0,0,6,0">
                                <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" Foreground="#A18BCF" FontSize="17" Margin="0,1,10,0"/><TextBlock Text="整合包设置" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                    <TextBlock Text="为喜欢的游戏整理一份 Mod 清单。" Foreground="#858D9E" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,19,0,0">
                                    <TextBlock Text="整合包名称" FontSize="11" Foreground="#7B8599" Margin="0,0,0,6"/>
                                    <TextBox x:Name="PackNameBox" Text="My_Modpack" Height="37" ToolTip="使用字母、数字、下划线，最多 128 个字符"/>
                                    <TextBlock Text="游戏 / 社区" FontSize="11" Foreground="#7B8599" Margin="0,13,0,6"/>
                                    <Grid>
                                        <TextBox x:Name="GameBox" Text="" Height="37" TextChanged="Game_Changed" ToolTip="可填游戏名称或社区标识；留空为通用。请将同一游戏的 Mod 放在一起。"/>
                                        <TextBlock Text="可选，例如 致命公司 / lethal-company" IsHitTestVisible="False" Foreground="#929BAD" FontSize="10" VerticalAlignment="Center" Margin="11,0,9,0" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=GameBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Grid Margin="0,13,0,6"><TextBlock Text="版本号" FontSize="11" Foreground="#7B8599"/><TextBlock Text="x.y.z" FontFamily="Segoe UI" FontSize="11" Foreground="#9BA3B3" HorizontalAlignment="Right"/></Grid>
                                    <TextBox x:Name="VersionBox" Text="1.0.0" Height="37" ToolTip="例如 1.0.0"/>
                                    <TextBlock Text="一句话简介" FontSize="11" Foreground="#7B8599" Margin="0,13,0,6"/>
                                    <TextBox x:Name="DescriptionBox" Text="我的 Thunderstore Mod 整合包" Height="62" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="250" VerticalContentAlignment="Top" Padding="11,10"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,19,0,0">
                                    <TextBlock Text="离线包内容" FontSize="11" Foreground="#7B8599" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="InstallModeBox" SelectedIndex="0" SelectionChanged="InstallMode_Changed" Height="36" FontSize="12" Foreground="#596277" Background="#FAFBFD" BorderBrush="#E6E8F0" Padding="9,7" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="通用原包（所有游戏）"/>
                                        <ComboBoxItem Content="BepInEx 安装目录"/>
                                    </ComboBox>
                                    <TextBlock x:Name="InstallModeHintText" Foreground="#858D9E" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="保留原始 ZIP，不套用游戏安装目录。"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=InstallModeBox}" Value="1"><Setter Property="Text" Value="按常见 BepInEx 目录整理，请确认游戏使用该加载器。"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="导出格式" FontSize="11" Foreground="#7B8599" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ExportFormatBox" SelectedIndex="0" Height="36" FontSize="12" Foreground="#596277" Background="#FAFBFD" BorderBrush="#E6E8F0" Padding="9,7" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="离线整合包"/>
                                        <ComboBoxItem Content="Thunderstore 发布包"/>
                                    </ComboBox>
                                    <TextBlock x:Name="ExportHintText" Foreground="#858D9E" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="包含 Mod 本体，方便直接分享给朋友。"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ExportFormatBox}" Value="1"><Setter Property="Text" Value="仅包含发布清单，管理器会联网下载依赖。"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Row="3" Height="1" Background="#EEF0F5" Margin="0,17,0,0"/>
                                <StackPanel Grid.Row="4" Margin="0,17,0,10" VerticalAlignment="Top">
                                    <TextBlock Text="导出预览" Foreground="#7E899D" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,9"><TextBlock Text="已选 Mod" Foreground="#858D9E" FontSize="11"/><TextBlock x:Name="ExportCountText" Text="0 个" Foreground="#6C778C" FontSize="11" FontFamily="Segoe UI" HorizontalAlignment="Right"/></Grid>
                                    <Grid><TextBlock Text="压缩包总大小" Foreground="#858D9E" FontSize="11"/><TextBlock x:Name="ExportSizeText" Text="0 B" Foreground="#6C778C" FontSize="11" FontFamily="Segoe UI" HorizontalAlignment="Right"/></Grid>
                                </StackPanel>
                                </Grid>
                                </ScrollViewer>
                                <StackPanel Grid.Row="1">
                                    <Border x:Name="ExportReadyPanel" Background="#F6F8FB" CornerRadius="7" Padding="10,9" Margin="0,0,0,11">
                                        <StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="#A7AFBE" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="ReadyText" Text="等待导入 Mod" Foreground="#858D9E" FontSize="11" TextWrapping="Wrap" MaxWidth="204"/></StackPanel>
                                    </Border>
                                    <Button x:Name="ExportButton" Click="Export_Click" Style="{StaticResource PrimaryButton}" Height="43" IsEnabled="False">
                                        <Grid Width="192"><TextBlock Text="导出整合包" HorizontalAlignment="Center" FontSize="12"/><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                    </Button>
                                    <TextBlock Text="打包前会校验前置与文件冲突" FontSize="11" Foreground="#929BAD" HorizontalAlignment="Center" Margin="0,11,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" BorderBrush="#E9ECF2" BorderThickness="0,1,0,0" Background="#F9FAFC">
                    <Grid Margin="30,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar x:Name="WorkProgress" Width="43" Height="3" IsIndeterminate="True" Foreground="#8E75DB" Background="#E7E1F8" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Text="就绪 · 拖入 ZIP 或点击「添加 Mod」开始" Foreground="#858D9E" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LatestActivityText" Grid.Column="2" Text="原始文件始终保留" Foreground="#9099AA" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
